{
  "name": "aurora-launcher",
  "private": true,
  "version": "0.4.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "tauri": "node node_modules/@tauri-apps/cli/tauri.js",
    "icons": "node scripts/generate-icons.mjs",
    "bundle:windows": "node scripts/build-variant.mjs standard",
    "bundle:standard": "node scripts/build-variant.mjs standard",
    "bundle:cn": "node scripts/build-variant.mjs cn"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}

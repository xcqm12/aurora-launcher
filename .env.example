# Aurora Launcher local configuration
# Copy this file to .env and fill in local-only credentials.
# Never commit .env or paste the key into source code.

# Option A (development): direct CurseForge requests using a personal key.
CURSEFORGE_API_KEY=

# Option B (recommended for release): route CurseForge requests through your
# own HTTPS proxy. When set, Aurora does not read or send any local API key.
# Contract: GET {proxy}/search and GET {proxy}/files/{modId} accept the same
# query parameters as the CurseForge API and return its JSON shape.
AURORA_CURSEFORGE_PROXY=
